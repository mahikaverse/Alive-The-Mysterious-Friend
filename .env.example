# ======================================================
# Alive – The Mysterious Friend
# Environment Configuration
# ======================================================

# ------------------------------------------------------
# Application
# ------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# ------------------------------------------------------
# Server
# ------------------------------------------------------
HOST=0.0.0.0
PORT=8000
SHUTDOWN_TIMEOUT=30

# ------------------------------------------------------
# API Keys
# ------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
NVIDIA_API_KEY=YOUR_NVIDIA_NIM_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
GROK_API_KEY=YOUR_XAI_GROK_API_KEY
API_KEY=

# ------------------------------------------------------
# Database
# ------------------------------------------------------
DATABASE_URL=postgresql://alive:alive@postgres:5432/alive

# ------------------------------------------------------
# LLM Provider
# ------------------------------------------------------
LLM_PROVIDER=deepseek
LLM_FALLBACK_ORDER=nvidia,openrouter,grok
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
DEEPSEEK_MODEL=deepseek-chat
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
OPENROUTER_MODEL=deepseek/deepseek-chat
GROK_MODEL=grok-2-latest

# ------------------------------------------------------
# Model Defaults
# ------------------------------------------------------
MODEL_NAME=alive-v1
MAX_TOKENS=150
TEMPERATURE=0.7

# ------------------------------------------------------
# CORS
# ------------------------------------------------------
CORS_ORIGINS=["*"]

# ------------------------------------------------------
# Trusted Hosts
# ------------------------------------------------------
TRUSTED_HOSTS=["*"]

# ------------------------------------------------------
# Usage Limits & Token Saving
# ------------------------------------------------------
MAX_CONVERSATIONS_PER_DAY=100
DAILY_TOKEN_BUDGET=0
COMPACT_CONVERSATION_ENABLED=true
CONVERSATION_TOKEN_THRESHOLD=6000
CONVERSATION_KEEP_RECENT=10
LLM_CACHE_ENABLED=false
LLM_CACHE_MAX_ENTRIES=256

# ------------------------------------------------------
# Memory & Embeddings
# ------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=alive_memories
MEMORY_TOP_K=5
MEMORY_IMPORTANCE_THRESHOLD=0.5