# ──────────────────────────────────────────────
# Alive – The Mysterious Friend
# Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ──────────────────────────────────────────────


# ── Application ──────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # enables hot-reload; must be false in production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR


# ── Server ───────────────────────────────────
HOST=0.0.0.0
PORT=8000
SHUTDOWN_TIMEOUT=30              # graceful shutdown wait (seconds)


# ── API Keys ─────────────────────────────────
# At least one of these is required by the LLM Provider.
OPENAI_API_KEY=
GEMINI_API_KEY=
API_KEY=                         # optional: authenticate incoming requests


# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://alive:alive@localhost:5432/alive


# ── LLM Provider (Person 2) ─────────────────
LLM_PROVIDER=openai                   # openai | gemini
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# ── Model Defaults ───────────────────────────
MODEL_NAME=alive-v1
MAX_TOKENS=300
TEMPERATURE=0.7


# ── CORS ─────────────────────────────────────
CORS_ORIGINS=["*"]               # JSON list of allowed origins


# ── Trusted Hosts ────────────────────────────
TRUSTED_HOSTS=["*"]              # JSON list of allowed Host headers
