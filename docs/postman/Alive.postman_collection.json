{
  "info": {
    "_postman_id": "1a2b3c4d-5e6f-4a5b-9c8d-7e6f5a4b3c2d",
    "name": "Alive - Manual Testing",
    "description": "Manual test suite for the Alive API.\n\nPublic endpoints (no auth required):\n- GET /health, GET /ready, GET /metrics\n\nProtected endpoints (auth enforced when API_KEY is set in .env):\n- POST /chat/completions, GET /usage, GET /notifications\n\nVariables:\n- baseUrl:   server base URL (default http://localhost:8000)\n- apiKey:    API key - leave empty when API_KEY is not set in .env\n- model:     model identifier (default alive-v1)\n- requestId: used to verify X-Request-ID echo propagation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Operational / Health",
      "item": [
        {
          "name": "GET /health - liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Expect 200 with status ok, version 1.1.0, uptime_seconds, model, environment."
          },
          "response": []
        },
        {
          "name": "GET /ready - readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/ready",
              "host": ["{{baseUrl}}"],
              "path": ["ready"]
            },
            "description": "Expect 200 with status ready and orchestrator initialised."
          },
          "response": []
        },
        {
          "name": "GET /metrics - request metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metrics",
              "host": ["{{baseUrl}}"],
              "path": ["metrics"]
            },
            "description": "Expect 200 with total_requests, requests_by_path, requests_by_status, avg_latency_seconds."
          },
          "response": []
        },
        {
          "name": "GET /usage - LLM usage report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usage",
              "host": ["{{baseUrl}}"],
              "path": ["usage"]
            },
            "description": "Expect 200 with date, conversations_today, providers map (per-provider tokens, calls, exhausted)."
          },
          "response": []
        },
        {
          "name": "GET /notifications - runtime events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/notifications?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Expect 200 with a notifications list (provider exhaustion, compaction, daily limit)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Chat - Happy Path",
      "item": [
        {
          "name": "Basic greeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\"role\": \"user\", \"content\": \"Hello! Who are you?\"}\n  ],\n  \"temperature\": 0.7,\n  \"max_tokens\": 300\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "completions"]
            },
            "description": "Expect 200. Response has id (chatcmpl-...), object chat.completion, created, model, choices[0].message.role=assistant, finish_reason=stop, usage."
          },
          "response": []
        },
        {
          "name": "With system message",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"You are Alive, a mysterious friend.\"},\n    {\"role\": \"user\", \"content\": \"What are you thinking about?\"}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "completions"]
            },
            "description": "Expect 200 with a non-empty response."
          },
          "response": []
        },
        {
          "name": "Multi-turn conversation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\"role\": \"user\", \"content\": \"Hello!\"},\n    {\"role\": \"assistant\", \"content\": \"Hey! How's it going?\"},\n    {\"role\": \"user\", \"content\": \"I'm good! I just got a new book.\"}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "completions"]
            },
            "description": "Expect 200. Response should reflect the conversation history."
          },
          "response": []
        },
        {
          "name": "Memory: introduce yourself",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\"role\": \"user\", \"content\": \"My name is Rahul and I love cricket. Remember that.\"}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "completions"]
            },
            "description": "Store a memory. Requires OPENAI_API_KEY (embeddings) + a running PostgreSQL/ChromaDB for persistence."
          },
          "response": []
        },
        {
          "name": "Memory: recall",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\"role\": \"user\", \"content\": \"What do you remember about me?\"}\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "completions"]
            },
            "description": "Expect Alive to recall details stored in the previous request (name, interest)."
          },
          "response": []
        },
        {
          "name": "Zero temperature (deterministic)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\"role\": \"user\", \"content\": \"Say something\"}\n  ],\n  \"temperature\": 0.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/chat/completions",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "completions"]
            },
            "description": "Expect 200. temperature 0.0 is valid (range 0.0-2.0)."
          },
          "response": []
        }
      ]
    },
